                    <div id="activeOrderBanner" class="hidden rounded-2xl border border-[rgb(var(--accent))]/25 bg-[rgb(var(--accent))]/10 px-5 py-4 text-sm text-[rgb(var(--muted))]">
                        <p class="text-[10px] font-medium tracking-[0.26em] uppercase text-[rgb(var(--muted-2))]" data-i18n="order.inProgressKicker">In progress</p>
                        <p class="mt-2 text-[rgb(var(--fg))]" data-i18n="order.inProgressLine">You have an open order from this table.</p>
                        <a id="activeOrderTrackLink" href="#" class="mt-3 inline-block text-xs font-medium tracking-[0.18em] uppercase text-[rgb(var(--accent))] underline-offset-4 hover:underline"></a>
                    </div>

                    <div>
                        <div class="flex items-center justify-between gap-2">
                            <div class="text-xs font-medium text-[rgb(var(--muted))]" data-i18n="cart.itemsLabel">Items</div>
                            <button type="button" class="guest-hit inline-flex min-h-10 items-center rounded-full px-3 text-xs text-[rgb(var(--muted))] transition hover:bg-[rgba(26,20,16,0.06)] hover:text-[rgb(var(--fg))] active:scale-[0.98]" onclick="clearCart()" data-i18n="cart.clear">Clear tray</button>
                        </div>
                        <div id="cartItemsHome" class="mt-3 space-y-2 text-sm text-[rgb(var(--muted))]"></div>
                    </div>

                    <div class="pt-4">
                        <div class="hairline"></div>
                        <div class="mt-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                            <div class="order-2 text-xs leading-relaxed text-[rgb(var(--muted-2))] md:order-1" data-i18n="cart.pricesNote">Prices are confirmed when you submit.</div>
                            <button type="button"
                                    id="cartSubmitBtn"
                                    class="btn-ink guest-hit order-1 w-full justify-center disabled:opacity-50 md:order-2 md:w-auto"
                                    onclick="submitCartOrder()"
                                    @(Model.HasSeatedTable ? null : (object)"disabled=\"disabled\"")
                                    data-i18n="cart.submit">
                                Place order
